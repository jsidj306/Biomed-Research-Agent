# Biomedical Research Agent - Environment Variables
# Copy this file to .env and fill in your actual keys
# cp .env.example .env

# PubMed / NCBI (Required - Free)
# Get your key at: https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# OpenAI (Required)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic / Claude (Optional - Recommended for multi-model validation)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Semantic Scholar (Optional - No key required, rate limit: 100/min without key)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
